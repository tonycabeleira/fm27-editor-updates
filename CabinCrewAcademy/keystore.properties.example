# Copy to keystore.properties (git-ignored) and fill in to sign release builds with your own key.
# Create a key with:
#   keytool -genkeypair -v -keystore keystore/my-release.jks -alias myalias -keyalg RSA -keysize 2048 -validity 10000
storeFile=keystore/my-release.jks
storePassword=
keyAlias=myalias
keyPassword=
